# VERIFIER HOST ONLY (a different machine and provider from the proposer).
# Its only input is the public feed URL. It must never be given a path or address of the proposer.
[Unit]
Description=QWATT independent verifier
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
User=qwatt
WorkingDirectory=/opt/qwatt
# --port 8090 listens on 127.0.0.1 only, for the operator (curl localhost:8090/status.json). The public copy of
# decisions.jsonl, refusals.jsonl and status.json is the verifier log, published by qwatt-verifier-log.service.
ExecStart=/usr/bin/node anchor/verifier.js --feed ${QWATT_FEED_URL} --config /etc/qwatt/anchor.json --sign-with-key qwatt-verifier --state /var/lib/qwatt/verifier --interval 30 --port 8090
# verifier.env holds only QWATT_FEED_URL=https://… (public). The verifier key is the stellar-cli identity
# qwatt-verifier of user qwatt (~qwatt/.config/stellar), generated on this host (freeze v3, V3-8);
# stellar must be on PATH (/usr/local/bin). A QWATT_VERIFIER_SECRET in the environment stops the service.
EnvironmentFile=/etc/qwatt/verifier.env
# V3-13a: restarted after a crash only. A clean exit stays stopped (qwatt-live exits 0 at run_end), and so does
# exit 2, a start the service refuses (arguments, configuration or key), which a restart cannot fix: the unit
# shows failed (status=2). A plain SIGTERM is a clean stop too; kill tests use SIGKILL (host README, AT-26).
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=2

[Install]
WantedBy=multi-user.target
