# /etc/qwatt/*.env — one file per service, chmod 600, owner root. NEVER commit real values.
# no secret ever goes into an env file (V3-8): each key is a stellar-cli identity on its own host.
# Deploy keys are files on their own host (/home/qwatt/.ssh/qwatt-evidence on the proposer host,
# /home/qwatt/.ssh/qwatt-verifier-log on the verifier host), never values in an env file.
# live.env
# When the run starts (UTC ISO time, or "now"; rounded up to the next 5-minute boundary). It is
# written once into faults.json, so a restart keeps it. Each new run needs an empty feed directory.
#   week-2 rehearsal on the real account (tests T1-T10, Thu 29 Oct): now
#   the live run (freeze v3 V3-14, Sat 7 Nov 00:00 Santiago): 2026-11-07T03:00:00Z, on a fresh feed
QWATT_RUN_START=now
# The run length in whole days from QWATT_RUN_START (qwatt-live passes it as --days; written once into
# faults.json, so a restart must keep it). The live run: 8, from 2026-11-07T03:00:00Z, so run_end is
# 2026-11-15T03:00:00Z: one soak day (Sat 7), then the seven counted days (Sun 8 03:00 UTC to
# Sun 15 03:00 UTC), on which the eight faults fall (Sun 8 - Fri 13). Unset, qwatt-live exits 2.
QWATT_RUN_DAYS=8
# public keys only (G…); never a secret (S…). A real-time run will not start without all three.
# They are published in faults.json (anchoring.signers), which never changes: wrong keys mean a new feed.
QWATT_PROPOSER_PUBLIC=G...
QWATT_VERIFIER_PUBLIC=G...
QWATT_THIRD_PUBLIC=G...
# The run's site name is not set here: live/run.js fixes site_id = qwatt-chispa-01 (FD-14), so every
# batch id is qwatt-chispa-01-000000, qwatt-chispa-01-000001, … (the reconciliation page shows them).
# publish.env  (proposer host only)
# QWATT_RUN names the run's directory in both public repositories. Choose it; there is no default.
#   a rehearsal (week 2: T1-T10, Thu 29 Oct): rehearsal-YYYY-MM-DD with the date, e.g. rehearsal-2026-10-29
#   `run` is only for the seven-day live run (freeze v3 V3-7 D1, OD-5), on a fresh feed
# The public history is never rewritten: once a run is published under a name, that directory is taken
# for good and the name can never be reused. A rehearsal published as `run` would take the live run's name.
# The placeholder below is not a valid run name (names are lowercase), so qwatt-publish and
# qwatt-verifier-log exit 2 until it is replaced. Use the same name in publish.env, verifier-log.env
# and every URL below.
QWATT_RUN=rehearsal-YYYY-MM-DD
# verifier.env  (verifier host only; the URL ends in the run name)
# The branch in a raw.githubusercontent.com URL is resolved to its head commit on every tick (from the
# anonymous github.com/<owner>/<repo>.git/info/refs) and every file is read at that commit (D7).
QWATT_FEED_URL=https://raw.githubusercontent.com/academiaseul/qwatt-evidence/main/rehearsal-YYYY-MM-DD
# verifier-log.env  (verifier host only; the same run name as publish.env)
QWATT_RUN=rehearsal-YYYY-MM-DD
# watch.env  (both URLs end in the same run name)
QWATT_ANCHOR_ACCOUNT=G...
QWATT_FEED_URL=https://raw.githubusercontent.com/academiaseul/qwatt-evidence/main/rehearsal-YYYY-MM-DD
QWATT_VERIFIER_LOG_URL=https://raw.githubusercontent.com/academiaseul/qwatt-verifier-log/main/rehearsal-YYYY-MM-DD
QWATT_ALERT_WEBHOOK=https://ntfy.sh/<private topic>
