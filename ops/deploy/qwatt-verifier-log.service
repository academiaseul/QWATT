# Verifier host ONLY — publishes the verifier's state directory to github.com/academiaseul/qwatt-verifier-log, main, <run>/
# (decisions.jsonl and refusals.jsonl only grow; status.json is replaced, at most every 5 minutes when nothing else changed).
# It shares no key and no file with the proposer host.
[Unit]
Description=QWATT verifier log publisher (qwatt-verifier-log)
After=network-online.target
Wants=network-online.target

[Service]
User=qwatt
WorkingDirectory=/opt/qwatt
# The deploy key is a file on this host only (qwatt-verifier-log, write access, nothing else); its path is passed to ssh, never read here.
ExecStart=/usr/bin/node ops/publish-feed.js --kind verifier-log --feed /var/lib/qwatt/verifier --run ${QWATT_RUN} --remote git@github.com:academiaseul/qwatt-verifier-log.git --branch main --work /var/lib/qwatt/verifier-log-repo --ssh-key /home/qwatt/.ssh/qwatt-verifier-log --interval 60 --status-every 300
# QWATT_RUN: the same run name the proposer host publishes under
EnvironmentFile=/etc/qwatt/verifier-log.env
# V3-13a: restarted after a crash only. A clean exit stays stopped (qwatt-live exits 0 at run_end), and so does
# exit 2, a start the service refuses (arguments, configuration or key), which a restart cannot fix: the unit
# shows failed (status=2). A plain SIGTERM is a clean stop too; kill tests use SIGKILL (host README, AT-26).
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=2

[Install]
WantedBy=multi-user.target
