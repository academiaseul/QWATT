# Proposer host — signs published, self-verified batches; writes feed/pending/<id>.xdr. Never submits.
[Unit]
Description=QWATT proposer
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
User=qwatt
WorkingDirectory=/opt/qwatt
# The proposer key is the stellar-cli identity qwatt-proposer of user qwatt (~qwatt/.config/stellar),
# generated on this host (freeze v3, V3-8). stellar must be on PATH (/usr/local/bin). No env file:
# there is no secret to load, and a QWATT_PROPOSER_SECRET in the environment stops the service.
ExecStart=/usr/bin/node anchor/proposer.js --feed /var/lib/qwatt/feed --config /etc/qwatt/anchor.json --sign-with-key qwatt-proposer --interval 30
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
