# Watchdog — preferably on the verifier host or a third machine, never only on the proposer host
# (a watchdog that dies with what it watches cannot report that it died).
[Unit]
Description=QWATT watchdog
After=network-online.target
Wants=network-online.target

[Service]
User=qwatt
WorkingDirectory=/opt/qwatt
ExecStart=/usr/bin/node ops/watch.js --account ${QWATT_ANCHOR_ACCOUNT} --feed ${QWATT_FEED_URL} --verifier-log ${QWATT_VERIFIER_LOG_URL} --state /var/lib/qwatt/ops --interval 300
# QWATT_ALERT_WEBHOOK=https://ntfy.sh/<private topic>  (or any webhook) — set when the alert recipient is named
EnvironmentFile=/etc/qwatt/watch.env
# V3-13a: restarted after a crash only. A clean exit stays stopped (qwatt-live exits 0 at run_end), and so does
# exit 2, a start the service refuses (arguments, configuration or key), which a restart cannot fix: the unit
# shows failed (status=2). A plain SIGTERM is a clean stop too; kill tests use SIGKILL (host README, AT-26).
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=2

[Install]
WantedBy=multi-user.target
