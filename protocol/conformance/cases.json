      "expect": { "verdict": "reject", "fail": ["elevation"], "codes": { "elevation": "elevation.night" } }
    },
    {
      "id": "rooftop-over-nameplate", "profile": "rooftop",
      "description": "5.2 kWh in one hour from 4.4 kWp exceeds the 1.15× ceiling",
      "input": { "ts_start": "2026-08-25T16:00:00Z", "ts_end": "2026-08-25T17:00:00Z", "dt_s": 3600,
                 "meters": { "a": { "id": "m1-dc", "class": "dc", "wh": 5200 }, "b": { "id": "m2-ac", "class": "ac", "wh": 5000 } } },
      "expect": { "verdict": "reject", "fail": ["nameplate"], "codes": { "nameplate": "nameplate.over" } }
    },
    {
      "id": "rooftop-twilight-rejected", "profile": "rooftop",
      "description": "Same instant the bench profile accepts (sun ≈ −1°): this profile's −0.833° threshold rejects it — thresholds are per profile, the rule is shared",
      "input": { "ts_start": "2026-09-20T22:38:00Z", "ts_end": "2026-09-20T22:43:00Z", "dt_s": 300,
                 "meters": { "a": { "id": "m1-dc", "class": "dc", "wh": 20 }, "b": { "id": "m2-ac", "class": "ac", "wh": 19 } } },
      "expect": { "verdict": "reject", "fail": ["elevation"], "codes": { "elevation": "elevation.night" } }
    }
  ]
}
