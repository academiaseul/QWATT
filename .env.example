# QWATT — environment template. Copy to .env and fill in locally:  cp .env.example .env
# .env is ignored by git (see .gitignore). Only this file, with placeholders, is committed.
#
# Rules:
# - Public keys only (G...). A secret key (S...) or a recovery phrase is NEVER written in any env file:
#   each signing key is a stellar-cli identity on its own machine (docs/RUNBOOK.md, freeze v3 V3-8).
# - Stellar testnet only.

# --- Network (testnet) --------------------------------------------------------
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org

# --- Anchoring account and its three signers (public keys only) ---------------
QWATT_ANCHOR_ACCOUNT=G...
QWATT_PROPOSER_PUBLIC=G...
QWATT_VERIFIER_PUBLIC=G...
QWATT_THIRD_PUBLIC=G...

# --- Run -------------------------------------------------------------------------
QWATT_RUN=rehearsal-YYYY-MM-DD
QWATT_RUN_START=now
QWATT_RUN_DAYS=7

# --- Public evidence feeds ---------------------------------------------------------
QWATT_FEED_URL=https://raw.githubusercontent.com/academiaseul/qwatt-evidence/main/rehearsal-YYYY-MM-DD
QWATT_VERIFIER_LOG_URL=https://raw.githubusercontent.com/academiaseul/qwatt-verifier-log/main/rehearsal-YYYY-MM-DD

# --- Alerts (private topic URL; keep it out of git) ---------------------------------
QWATT_ALERT_WEBHOOK=https://ntfy.sh/<your-private-topic>

# Server deployments use one file per service in /etc/qwatt/: see ops/deploy/env.example.
